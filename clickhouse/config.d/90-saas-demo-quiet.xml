<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared Mac-mini Demo: disable high-volume internal profiling/metric history.
  system.trace_log and system.text_log dominate the current ClickHouse dataset,
  while the actual dc.kline history is tiny (2026-10-08 inspection).
  Keep system.query_log, system.error_log, system.part_log, crash logging and
  the server's ordinary file logs for operational visibility.
  These changes take effect after a planned ClickHouse-only restart.
  Existing system log tables are NOT dropped, truncated or mutated.
  Not suitable for an environment requiring detailed query stack profiling.
-->
<clickhouse>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
</clickhouse>
