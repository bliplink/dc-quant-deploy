+    /** v19 isolated learner catch-up. A is still non-writable and remains a
+     * learner after install; this never changes membership or grants READY.
+     * Original WAL is fsync-archived before a fully replayed copy replaces it.
+     */
+    synchronized boolean installRf2LearnerImage(String partitionId,
+            DemoV19TcpSnapshotReceiver.Image image,
+            Rf2LearnerRecheck proof) throws Exception {
+        if (!"P000".equals(partitionId) || image==null || proof==null
+                || image.bytes==null || image.bytes.length==0
+                || image.bytes.length>DemoV19SnapshotExport.MAX_BYTES
+                || image.committedSeq<1 || image.epoch!=2
+                || !"CommonHaDemoB".equals(image.node))
+            throw new IOException("invalid certified learner image");
+        DemoDurableJournal old=journal(partitionId);
+        synchronized (old) {
+            if (!old.isReadyForWrites() || old.committedSeq()>image.committedSeq)
+                throw new IOException("learner WAL dirty or ahead of source");
+            if (!DemoV19SnapshotExport.sha256(image.bytes).equals(image.sha256))
+                throw new IOException("remote image digest mismatch");
+            if (old.committedSeq()==image.committedSeq) {
+                if (!old.committedPrefixSha256().equals(image.sha256))
+                    throw new IOException("same-index learner history diverged");
+                return false;
+            }
+            Path active=old.path();
+            Path evidence=active.getParent().resolve(".rf2-learner-evidence");
+            Files.createDirectories(evidence);
+            String ticket="P000-epoch2-"+UUID.randomUUID();
+            Path archive=evidence.resolve(ticket+".original.wal");
+            Path staged=evidence.resolve(ticket+".staged.wal");
+            Path receipt=evidence.resolve(ticket+".receipt.json");
+            byte[] original=Files.readAllBytes(active);
+            if (original.length>16*1024*1024)
+                throw new IOException("old learner WAL exceeds bounded archive");
+            Files.write(staged,image.bytes,StandardOpenOption.CREATE_NEW,StandardOpenOption.WRITE);
+            forceFile(staged);
+            try (DemoDurableJournal candidate=new DemoDurableJournal(staged)) {
+                if (!candidate.isReadyForWrites() || candidate.committedSeq()!=image.committedSeq
+                        || candidate.lastEpoch()!=image.epoch
+                        || !image.sha256.equals(candidate.committedPrefixSha256())
+                        || !image.stateDigest.equals(candidate.state().stateDigest())
+                        || !old.isCommittedPrefixOf(candidate))
+                    throw new IOException("learner WAL cannot prove append-only source history");
+            }
+            Files.write(archive,original,StandardOpenOption.CREATE_NEW,StandardOpenOption.WRITE);
+            forceFile(archive);
+            if (!sha256(original).equals(sha256(Files.readAllBytes(archive))))
+                throw new IOException("old learner evidence archive mismatch");
+            Map<String,Object> record=new LinkedHashMap<String,Object>();
+            record.put("kind","RF2_EPOCH2_LEARNER_INSTALL_UNACTIVATED");
+            record.put("partitionId",partitionId);
+            record.put("node","CommonHaDemo"+node);
+            record.put("source",image.node);
+            record.put("sourceEpoch",image.epoch);
+            record.put("oldSeq",old.committedSeq());
+            record.put("oldSha256",old.committedPrefixSha256());
+            record.put("sourceSeq",image.committedSeq);
+            record.put("sourceSha256",image.sha256);
+            record.put("sourceStateDigest",image.stateDigest);
+            record.put("archivedWal",archive.toString());
+            record.put("activated",false);
+            Files.write(receipt,JsonUtils.Serializer(record).getBytes(StandardCharsets.UTF_8),
+                    StandardOpenOption.CREATE_NEW,StandardOpenOption.WRITE);
+            forceFile(receipt);
+            forceDirectory(evidence);
+            proof.requireStillLearner();
+            old.close();
+            try {
+                Files.move(staged,active,StandardCopyOption.ATOMIC_MOVE,
+                        StandardCopyOption.REPLACE_EXISTING);
+                forceDirectory(active.getParent());
+            } finally {
+                try { journals.put(partitionId,new DemoDurableJournal(active)); }
+                catch(IOException failure) {
+                    journals.remove(partitionId);
+                    throw failure;
+                }
+            }
+            DemoDurableJournal installed=journal(partitionId);
+            if (!installed.isReadyForWrites() || installed.committedSeq()!=image.committedSeq
+                    || !image.sha256.equals(installed.committedPrefixSha256())
+                    || !image.stateDigest.equals(installed.state().stateDigest()))
+                throw new IOException("learner installed WAL replay mismatch");
+            return true;
+        }
+    }
