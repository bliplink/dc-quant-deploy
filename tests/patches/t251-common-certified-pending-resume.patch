+package com.app.common.replication;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+/** T251: bad TCP or missing grant before WAL must never poison the replica. */
+public final class CommonReplicaPreflightFailureTest {
+    @Rule public TemporaryFolder temp=new TemporaryFolder();
+    private static final String A="NodeA", B="NodeB";
+    private static final class Keys {
+        final KeyPair a,b;
+        final DurableWalCommitQuorum.Membership m;
+        Keys()throws Exception {
+            KeyPairGenerator gen=KeyPairGenerator.getInstance("RSA");
+            gen.initialize(2048);
+            a=gen.generateKeyPair(); b=gen.generateKeyPair();
+            m=new DurableWalCommitQuorum.Membership("OrderSvr","P210",A,1,2,
+                Arrays.asList(new DurableWalCommitQuorum.Member(A,"hostA",a.getPublic()),
+                    new DurableWalCommitQuorum.Member(B,"hostB",b.getPublic())));
+        }
+    }
+    private ReplicationBatch message(Keys keys,String service,String partition,
+            long epoch,long sequence,String payload)throws Exception {
+        ReplicationRecord record=new ReplicationRecord(sequence,
+            "COMMON_BUSINESS_COMMAND","",System.currentTimeMillis(),payload.getBytes("UTF-8"));
+        return new ReplicationBatch(service,partition,epoch,Collections.singletonList(record));
+    }
+    @Test public void crossPartitionOutOfOrderAndStaleEpochDoNotPoisonDisk()
+            throws Exception {
+        Keys keys=new Keys();
+        Path walFile=temp.newFolder("wal-valid-after-invalid").toPath().resolve("business.wal");
+        try(CommonFileBusinessWal wal=new CommonFileBusinessWal(walFile,1)){
+            ReplicationBatch badService=message(keys,"OtherService","P210",1,1,"BAD");
+            ReplicationBatch wrongEpoch=message(keys,"OrderSvr","P210",2,1,"BAD");
+            ReplicationBatch wrongSequence=message(keys,"OrderSvr","P210",1,3,"BAD");
+            ReplicationBatch good=message(keys,"OrderSvr","P210",1,1,"ORIGINAL");
+            assertFalse(wal.receiveReplicated(badService,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertFalse(wal.receiveReplicated(wrongEpoch,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertFalse(wal.receiveReplicated(wrongSequence,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertEquals(0,wal.forcedSequence());
+            assertTrue("valid request must still work after malformed preflight",
+                wal.receiveReplicated(good,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertEquals(1,wal.forcedSequence());
+            assertTrue("identical retransmission remains idempotent",
+                wal.receiveReplicated(good,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertEquals(1,wal.forcedSequence());
+        }
+    }
+    @Test public void changedDuplicateIsFencedAfterFsyncHeadComparison()
+            throws Exception {
+        Keys keys=new Keys();
+        Path walFile=temp.newFolder("duplicate-conflict").toPath().resolve("business.wal");
+        try(CommonFileBusinessWal wal=new CommonFileBusinessWal(walFile,1)){
+            ReplicationBatch good=message(keys,"OrderSvr","P210",1,1,"ORIGINAL");
+            assertTrue(wal.receiveReplicated(good,keys.m,B,keys.b.getPrivate()).isSuccess());
+            ReplicationBatch forged=message(keys,"OrderSvr","P210",1,1,"DIVERGED");
+            assertFalse(wal.receiveReplicated(forged,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertFalse("divergent same-sequence WAL cannot be reauthorized",
+                wal.receiveReplicated(good,keys.m,B,keys.b.getPrivate()).isSuccess());
+            assertEquals(1,wal.forcedSequence());
+        }
+    }
+    @Test public void replicaExpiredGrantBeforeWalDoesNotPoisonOrBlockLaterValidWrite()
+            throws Exception {
+        Keys keys=new Keys();
+        Path root=temp.newFolder("replica-lease-first-revoked").toPath();
+        AtomicBoolean grant=new AtomicBoolean(true);
+        CommonCertifiedPartitionRuntime.CurrentGrant required=
+            new CommonCertifiedPartitionRuntime.CurrentGrant(){
+                public void primary()throws Exception{throw new IOException("wrong primary");}
+                public void replica()throws Exception {
+                    if(!grant.get())throw new IOException("temporarily expired certified replica lease");
+                }
+            };
+        DurableWalCertificateCustody.Authority authority=m->{
+            if(!grant.get())throw new IOException("old epoch grant unavailable");
+        };
+        try(CommonCertifiedPartitionRuntime replica=new CommonCertifiedPartitionRuntime(
+                root,keys.m,B,keys.b.getPrivate(),false,required,authority,
+                null,Collections.emptyMap(),500L)){
+            grant.set(false);
+            ReplicationBatch good=message(keys,"OrderSvr","P210",1,1,"REAL");
+            ReplicationAck blocked=replica.handle(good);
+            assertFalse(blocked.isSuccess());
+            assertEquals(0,replica.forcedSequence());
+            grant.set(true);
+            ReplicationAck committed=replica.handle(good);
+            assertTrue("refused preflight must not leave poisoned physical WAL",committed.isSuccess());
+            assertEquals(1,replica.forcedSequence());
+        }
+    }
+}
