+    /** Recover ONLY an already signed/fsynced receipt-quorum.pending.
+     *
+     * A crash can occur AFTER two custodians signed the installed certificate
+     * but BEFORE the atomic pending -> head rename. Ordinary constructors
+     * remain fail closed. This explicit, exclusive offline transition requires
+     * the original physical custody/WAL, current signed certificate, prior
+     * signed ledger (if any), an active old-Epoch authority and a new
+     * independently forced evidence archive. It NEVER creates a signature,
+     * authorizes a client ACK, or grants any new primary/READY privilege.
+     */
+    public static long completePreparedSignedQuorum(
+            Path path,DurableWalCommitQuorum.Membership members,
+            DurableWalCertificateCustody physical,
+            DurableWalCommitQuorum.Certificate proposed,
+            DurableWalCommitQuorum.Certificate previousCertificate,
+            DurableWalCertificateCustody.Authority authority,
+            Path independentArchiveDir)throws Exception {
+        if(path==null || members==null || physical==null
+                || proposed==null || authority==null || independentArchiveDir==null)
+            throw new IOException("complete pending receipt quorum requires pinned evidence");
+        Path canonical=path.toAbsolutePath().normalize();
+        Path archived=independentArchiveDir.toAbsolutePath().normalize();
+        if(!path.isAbsolute() || !independentArchiveDir.isAbsolute()
+                || archived.startsWith(canonical) || canonical.startsWith(archived)
+                || !Files.isDirectory(path,LinkOption.NOFOLLOW_LINKS)
+                || Files.isSymbolicLink(path)
+                || Files.exists(independentArchiveDir,LinkOption.NOFOLLOW_LINKS))
+            throw new IOException("independent new evidence directory outside receipt ledger required");
+        Path pending=path.resolve(PENDING),head=path.resolve(HEAD),lockFile=path.resolve(LOCK);
+        if(!Files.isRegularFile(pending,LinkOption.NOFOLLOW_LINKS)
+                || Files.isSymbolicLink(pending)
+                || Files.isSymbolicLink(head) || Files.isSymbolicLink(lockFile))
+            throw new IOException("no trustworthy incomplete pending receipt");
+        try(FileChannel channel=FileChannel.open(lockFile,StandardOpenOption.CREATE,
+                    StandardOpenOption.WRITE);
+            FileLock exclusive=channel.tryLock()) {
+            if(exclusive==null)throw new IOException("receipt quorum active writer cannot be recovered");
+            try(DirectoryStream<Path> listing=Files.newDirectoryStream(path)){
+                for(Path file:listing){
+                    String name=file.getFileName().toString();
+                    if((!LOCK.equals(name) && !HEAD.equals(name) && !PENDING.equals(name))
+                            || Files.isSymbolicLink(file)
+                            || !Files.isRegularFile(file,LinkOption.NOFOLLOW_LINKS))
+                        throw new IOException("unknown physical receipt recovery artifact");
+                }
+            }
+            // Validate both current and historical signatures BEFORE changing
+            // any ledger byte. The installed physical HEAD is not by itself a
+            // custody receipt quorum.
+            DurableWalCommitQuorum.Certificate current=physical.highestVerified();
+            DurableWalCommitQuorum.Certificate trusted=DurableWalCommitQuorum.verify(
+                    members,proposed.committedSequence,proposed.commitPrefixSha256,
+                    proposed.votes);
+            if(current==null || current.committedSequence!=trusted.committedSequence
+                    || !current.commitPrefixSha256.equals(trusted.commitPrefixSha256)
+                    || !current.membershipSha256.equals(trusted.membershipSha256))
+                throw new IOException("prepared quorum does not match physical custody/WAL");
+            byte[] pendingBytes=readBoundedReceiptFile(pending);
+            Record next=decodeRecord(members,pendingBytes);
+            DurableWalCustodyQuorum.CustodiedCertificate checked=
+                    DurableWalCustodyQuorum.verify(members,trusted,next.receipts);
+            if(next.seq!=trusted.committedSequence
+                    || !next.sha.equals(trusted.commitPrefixSha256)
+                    || checked.physicalCustodians!=members.majority())
+                throw new IOException("prepared quorum lacks exact independently signed custody");
+            byte[] oldBytes=null;
+            if(Files.exists(head,LinkOption.NOFOLLOW_LINKS)){
+                oldBytes=readBoundedReceiptFile(head);
+                Record old=decodeRecord(members,oldBytes);
+                if(previousCertificate==null)
+                    throw new IOException("missing previous signed receipt certificate");
+                DurableWalCommitQuorum.Certificate previous=DurableWalCommitQuorum.verify(
+                        members,previousCertificate.committedSequence,
+                        previousCertificate.commitPrefixSha256,previousCertificate.votes);
+                DurableWalCustodyQuorum.CustodiedCertificate oldSigned=
+                        DurableWalCustodyQuorum.verify(members,previous,old.receipts);
+                if(old.seq<=0 || old.seq>=next.seq
+                        || old.seq!=previous.committedSequence
+                        || !old.sha.equals(previous.commitPrefixSha256)
+                        || oldSigned.physicalCustodians!=members.majority())
+                    throw new IOException("old signed receipt ledger malformed or rolled back");
+            }else if(previousCertificate!=null || trusted.committedSequence!=1L)
+                throw new IOException("missing previous signed receipt ledger for non-genesis pending");
+            authority.requireOldEpochAuthorized(members);
+            // Archives are NEW, independent and fsynced before any move.
+            Files.createDirectory(independentArchiveDir);
+            forceImmutableEvidence(independentArchiveDir.resolve("signed-pending.bin"),pendingBytes);
+            if(oldBytes!=null)
+                forceImmutableEvidence(independentArchiveDir.resolve("previous-ledger.bin"),oldBytes);
+            forceEvidenceDirectory(independentArchiveDir);
+            forceEvidenceDirectory(independentArchiveDir.getParent());
+            authority.requireOldEpochAuthorized(members);
+            DurableWalCommitQuorum.Certificate stillInstalled=physical.highestVerified();
+            if(stillInstalled==null
+                    || stillInstalled.committedSequence!=trusted.committedSequence
+                    || !stillInstalled.commitPrefixSha256.equals(trusted.commitPrefixSha256)
+                    || !Arrays.equals(pendingBytes,readBoundedReceiptFile(pending))
+                    || (oldBytes!=null && !Arrays.equals(oldBytes,readBoundedReceiptFile(head))))
+                throw new IOException("signed pending evidence changed during authorized recovery");
+            Files.move(pending,head,StandardCopyOption.ATOMIC_MOVE,
+                    StandardCopyOption.REPLACE_EXISTING);
+            forceEvidenceDirectory(path);
+            // Does not publish READY. Only a subsequent ordinary Common
+            // runtime restart under a currently valid grant can do that.
+            return trusted.committedSequence;
+        }
+    }
+    private static byte[] readBoundedReceiptFile(Path file)throws IOException {
+        if(!Files.isRegularFile(file,LinkOption.NOFOLLOW_LINKS)
+                || Files.isSymbolicLink(file) || Files.size(file)<=0
+                || Files.size(file)>MAX_BYTES)
+            throw new IOException("untrusted receipt quorum file size/type");
+        return Files.readAllBytes(file);
+    }
+    private static Record decodeRecord(DurableWalCommitQuorum.Membership members,
+            byte[] source)throws Exception {
+        try(DataInputStream in=new DataInputStream(new ByteArrayInputStream(source))){
+            if(in.readInt()!=MAGIC || in.readInt()!=VERSION
+                    || !members.digest.equals(in.readUTF())
+                    || in.readLong()!=members.epoch)
+                throw new IOException("cross-membership custody receipt ledger");
+            long seq=in.readLong();String sha=in.readUTF();
+            int count=in.readInt();
+            if(seq<=0 || !sha.matches("[0-9a-f]{64}")
+                    || count!=members.majority())
+                throw new IOException("malformed custody receipt ledger header");
+            List<DurableWalCustodyQuorum.Receipt> receipts=new ArrayList<>();
+            for(int i=0;i<count;i++){
+                String node=in.readUTF(),part=in.readUTF(),m=in.readUTF(),hash=in.readUTF();
+                long epoch=in.readLong(),sequence=in.readLong();
+                int n=in.readInt();
+                if(n<=0 || n>1024)throw new IOException("unbounded physical signature");
+                byte[] signature=new byte[n];in.readFully(signature);
+                receipts.add(DurableWalCustodyQuorum.Receipt.fromWire(
+                        node,part,m,hash,epoch,sequence,signature));
+            }
+            if(in.read()!=-1)throw new IOException("trailing signed receipt ledger bytes");
+            return new Record(seq,sha,receipts);
+        }
+    }
+    private static void forceImmutableEvidence(Path file,byte[] raw)throws IOException {
+        try(FileChannel output=FileChannel.open(file,StandardOpenOption.CREATE_NEW,
+                StandardOpenOption.WRITE)){
+            ByteBuffer buffer=ByteBuffer.wrap(raw);
+            while(buffer.hasRemaining())output.write(buffer);
+            output.force(true);
+        }
+    }
+    private static void forceEvidenceDirectory(Path folder)throws IOException {
+        try(FileChannel dir=FileChannel.open(folder,StandardOpenOption.READ)){
+            dir.force(true);
+        }
+    }
+
     private void requireOpen()throws IOException {
         if(closed || !lock.isValid())throw new IOException("receipt ledger closed");
     }
