+    DEMO_V19_DEDICATED_ENSEMBLE: "1"
+    DEMO_V19_SINGLE_FORCE_PILOT: "0"
+    DEMO_V19_COMMON_QUORUM_TEST: "1"
+    DEMO_V19_SINGLE_HOST_QUORUM_TEST: "1"
+    # Isolated single-Mac three-JVM GROUP fsync pilot only. Never production.
+    DEMO_V19_GROUP_FORCE_PILOT: "1"
