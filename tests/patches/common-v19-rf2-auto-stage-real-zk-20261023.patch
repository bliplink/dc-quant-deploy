+name: otc-common-ha-v19-rf2-auto-stage
+
+# Physically separate Docker processes + WAL volumes, but still on the SAME
+# Mac/Docker VM: not three independent hardware failure domains.
+x-zk: &zk
+  image: docker.m.daocloud.io/library/zookeeper:3.8.4
+  restart: "no"
+  environment: &zk-env
+    ZOO_SERVERS: "server.1=otc-ha-zk1:2888:3888;2181 server.2=otc-ha-zk2:2888:3888;2181 server.3=otc-ha-zk3:2888:3888;2181"
+    ZOO_4LW_COMMANDS_WHITELIST: "ruok,stat,mntr"
+    JVMFLAGS: "-Xms64m -Xmx128m"
+  networks: [isolated]
+
+x-node: &node
+  image: dc-saas/gw:cluster-dev-fenced-transport-20261016
