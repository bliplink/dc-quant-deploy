+    private static java.util.List<com.app.common.partition.PartitionAssignment> awaitCertifiedAssignments(
+            OrderPartitionRuntime business, NodeClusterControlManager realZk)
+            throws IOException, InterruptedException {
+        final long deadline = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(20);
+        IOException last = null;
+        for (;;) {
+            try {
+                java.util.List<com.app.common.partition.PartitionAssignment> rows = business.assignmentsSnapshot();
+                if (!rows.isEmpty() && realZk.localPartitionCount() > 0) return rows;
+            } catch (IllegalStateException pending) {
+                last = new IOException("Order Common grant not yet certified", pending);
+            }
+            if (System.nanoTime() >= deadline)
+                throw new IOException("ORDER_COMMON_CERTIFIED_CENSUS_AWAIT_TIMEOUT", last);
+            Thread.sleep(100);
+        }
+    }
+
