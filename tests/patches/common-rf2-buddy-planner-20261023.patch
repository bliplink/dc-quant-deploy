+package com.app.common.partition;
+
+import org.junit.Test;
+import java.util.*;
+import static org.junit.Assert.*;
+
+public class PartitionBuddyPlacementPlannerTest {
+    private static List<ClusterNodeDescriptor> nodes(String... names) {
+        List<ClusterNodeDescriptor> result = new ArrayList<ClusterNodeDescriptor>();
+        for (String id : names) {
+            ClusterNodeDescriptor d = new ClusterNodeDescriptor();
+            d.setNodeName(id); d.setHost("physical-"+id);
+            d.setServiceName("OrderSvr");
+            d.setState(ClusterNodeLifecycleState.ACTIVE);
+            result.add(d);
+        }
+        return result;
+    }
+    private static List<PartitionAssignment> plan(String... ids) {
+        return PartitionBuddyPlacementPlanner.proposeNew(
+                256,1,nodes(ids),Collections.<PartitionAssignment>emptyList());
+    }
+    private static void verify(List<PartitionAssignment> plan, String[][] ranges) {
+        assertEquals(256,plan.size());
+        Map<String,Integer> primary = new HashMap<String,Integer>();
+        Map<String,Integer> replica = new HashMap<String,Integer>();
+        for (int i=0;i<256;i++) {
+            PartitionAssignment a = plan.get(i);
+            assertEquals(String.format(Locale.ROOT,"P%03d",i),a.getPartitionId());
+            assertEquals("PREPARING",a.getState());
+            assertFalse(a.isRoutable());
+            assertEquals(1,a.getEpoch());
+            assertEquals(0,a.getAssignmentVersion());
+            assertEquals(1,a.replicaNodes().size());
+            assertNotEquals(a.getPrimary(),a.getReplica());
+            primary.put(a.getPrimary(),primary.getOrDefault(a.getPrimary(),0)+1);
+            replica.put(a.getReplica(),replica.getOrDefault(a.getReplica(),0)+1);
+            String[] pair = ranges[i/(256/ranges.length)];
+            assertEquals(pair[0],a.getPrimary());
+            assertEquals(pair[1],a.getReplica());
+        }
+        for(String[] group:ranges) {
+            assertEquals(Integer.valueOf(256/ranges.length),primary.get(group[0]));
+            assertEquals(Integer.valueOf(256/ranges.length),replica.get(group[1]));
+        }
+    }
+    @Test public void twoNodesSplit128PrimaryEachAndOppositeStandby() {
+        verify(plan("B","A"),new String[][]{{"A","B"},{"B","A"}});
+    }
+    @Test public void fourNodesSplit64PrimaryEachIntoTwoIndependentPairs() {
+        verify(plan("D","A","C","B"),
+                new String[][]{{"A","B"},{"B","A"},{"C","D"},{"D","C"}});
+    }
+    @Test public void sixNodesRemainEvenAndNeverReplicateAllToAll() {
+        List<PartitionAssignment> plan=plan("A","B","C","D","E","F");
+        int[] primaries=new int[6],replicas=new int[6];
+        for(PartitionAssignment a:plan) {
+            int p=a.getPrimary().charAt(0)-'A';
+            int r=a.getReplica().charAt(0)-'A';
+            assertEquals(p^1,r);
+            primaries[p]++; replicas[r]++;
+        }
+        for(int i=0;i<6;i++) {
+            assertTrue(primaries[i]>=42 && primaries[i]<=43);
+            assertTrue(replicas[i]>=42 && replicas[i]<=43);
+        }
+    }
+    @Test public void failClosedForOddNodesAndColocatedPair() {
+        denied(()->plan("A","B","C"));
+        List<ClusterNodeDescriptor> ds=nodes("A","B");
+        ds.get(1).setHost("physical-A");
+        denied(()->PartitionBuddyPlacementPlanner.proposeNew(256,1,ds,
+                Collections.<PartitionAssignment>emptyList()));
+    }
+    @Test public void failClosedForDuplicateNodeAndInactiveMember() {
+        denied(()->plan("A","A"));
+        List<ClusterNodeDescriptor> ds=nodes("A","B");
+        ds.get(1).setState(ClusterNodeLifecycleState.REPLICA_READY);
+        denied(()->PartitionBuddyPlacementPlanner.proposeNew(256,1,ds,
+                Collections.<PartitionAssignment>emptyList()));
+    }
+    @Test public void rejectExistingAssignmentRatherThanSilentlyMoveIt() {
+        List<PartitionAssignment> before=plan("A","B");
+        denied(()->PartitionBuddyPlacementPlanner.proposeNew(256,2,nodes("A","B","C","D"),
+                Collections.singletonList(before.get(127))));
+        assertEquals("A",before.get(127).getPrimary());
+        assertEquals(1,before.get(127).getEpoch());
+    }
+    @Test public void rejectInvalidScaleAndServiceMix() {
+        denied(()->PartitionBuddyPlacementPlanner.proposeNew(1,1,nodes("A","B"),
+                Collections.<PartitionAssignment>emptyList()));
+        denied(()->PartitionBuddyPlacementPlanner.proposeNew(256,0,nodes("A","B"),
+                Collections.<PartitionAssignment>emptyList()));
+        List<ClusterNodeDescriptor> ds=nodes("A","B");
+        ds.get(1).setServiceName("TradeSvr");
+        denied(()->PartitionBuddyPlacementPlanner.proposeNew(256,1,ds,
+                Collections.<PartitionAssignment>emptyList()));
+    }
+    private static void denied(Runnable command) {
+        try { command.run(); fail("unsafe placement accepted"); }
+        catch (IllegalArgumentException expected) { /* must fail closed */ }
+    }
+}
