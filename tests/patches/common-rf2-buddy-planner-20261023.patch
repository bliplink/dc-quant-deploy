+package com.app.common.partition;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Deterministic RF2 buddy-pair INITIAL placement only. Each node is primary
+ * for about 1/N of the partitions and standby for its paired neighbor.
+ *
+ * It deliberately does not mutate ZooKeeper, migrate existing assignments,
+ * install a recovery image or grant READY. An operator must run the normal
+ * authenticated membership and genesis/learner transition protocol.
+ */
+public final class PartitionBuddyPlacementPlanner {
+    private PartitionBuddyPlacementPlanner() {}
+
+    public static List<PartitionAssignment> proposeNew(int partitionCount, long initialEpoch,
+            Collection<ClusterNodeDescriptor> available,
+            Collection<PartitionAssignment> existing) {
+        if (partitionCount < 1 || partitionCount > 999 || initialEpoch <= 0
+                || available == null || existing == null)
+            throw new IllegalArgumentException("bounded partitions, epoch, nodes and existing required");
+        List<ClusterNodeDescriptor> nodes = new ArrayList<ClusterNodeDescriptor>();
+        Set<String> identifiers = new HashSet<String>();
+        String service = null;
+        for (ClusterNodeDescriptor node : available) {
+            if (node == null || !node.isEligiblePrimary()
+                    || blank(node.getNodeName()) || blank(node.getHost())
+                    || blank(node.getServiceName()))
+                throw new IllegalArgumentException("pair nodes must be active with service/host identity");
+            String id = norm(node.getNodeName());
+            if (!identifiers.add(id)) throw new IllegalArgumentException("duplicate physical node identity");
+            if (service == null) service = norm(node.getServiceName());
+            else if (!service.equals(norm(node.getServiceName())))
+                throw new IllegalArgumentException("cannot mix service namespaces in a shard plan");
+            nodes.add(node);
+        }
+        if (nodes.size() < 2 || nodes.size() % 2 != 0 || nodes.size() > partitionCount)
+            throw new IllegalArgumentException("even number of nodes (>=2) and >=one partition per primary required");
+        nodes.sort(Comparator.comparing(n -> norm(n.getNodeName())));
+        // A/B, C/D, ... are separate replication groups, never one all-to-all quorum.
+        for (int i=0; i<nodes.size(); i+=2) {
+            if (norm(nodes.get(i).getHost()).equals(norm(nodes.get(i+1).getHost())))
+                throw new IllegalArgumentException("buddy nodes must not share a physical host");
+        }
+        Set<String> occupied = new HashSet<String>();
+        for (PartitionAssignment a : existing) {
+            if (a != null && !blank(a.getPartitionId())) occupied.add(norm(a.getPartitionId()));
+        }
+        List<PartitionAssignment> planned = new ArrayList<PartitionAssignment>(partitionCount);
+        for (int index=0; index<partitionCount; index++) {
+            String partition = String.format(Locale.ROOT, "P%03d", index);
+            if (occupied.contains(norm(partition)))
+                throw new IllegalArgumentException("existing partition requires certified learner migration: " + partition);
+            // Equal contiguous ranges if divisible (2=>128,4=>64).
+            // The monotonic floor formulation also balances uneven counts within one.
+            int primaryIndex = (int)(((long)index * nodes.size()) / partitionCount);
+            ClusterNodeDescriptor primary = nodes.get(primaryIndex);
+            ClusterNodeDescriptor standby = nodes.get(primaryIndex ^ 1);
+            PartitionAssignment a = new PartitionAssignment();
+            a.setPartitionId(partition);
+            a.setProtocolVersion(2);
+            a.setEpoch(initialEpoch);
+            a.setAssignmentVersion(0);
+            a.setPrimary(primary.getNodeName());
+            a.setReplicas(Collections.singletonList(standby.getNodeName()));
+            a.setState("PREPARING");
+            PartitionAssignmentValidator.requireValid(a);
+            planned.add(a);
+        }
+        return Collections.unmodifiableList(planned);
+    }
+
+    private static String norm(String s) { return s == null ? "" : s.trim().toLowerCase(Locale.ROOT); }
+    private static boolean blank(String s) { return s == null || s.trim().isEmpty(); }
+}
