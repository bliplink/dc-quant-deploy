+package com.app.common.partition;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** RF2 sole survivor may acquire fenced epoch metadata, never writable READY. */
+public final class PartitionRf2SurvivorFailoverTest {
+    private static final class Fixture implements PartitionFailoverController.Guard,
+            PartitionFailoverController.Membership,
+            PartitionFailoverController.AssignmentStore,
+            PartitionFailoverController.PromotionSafety {
+        final Set<String> live = new HashSet<String>(Arrays.asList("A", "B"));
+        final AtomicInteger proofs = new AtomicInteger();
+        int writes, version = 9;
+        boolean connected = true, leased = true, conflict, safe = true;
+        Runnable afterProof;
+        PartitionAssignment current = assignment("B");
+        PartitionFailoverController controller() {
+            return new PartitionFailoverController(this, this, this, this, 1);
+        }
+        public boolean isConnected() { return connected; }
+        public boolean hasLease() { return leased; }
+        public boolean isLive(String node) { return live.contains(node); }
+        public PartitionFailoverController.VersionedAssignment read(String p) {
+            return new PartitionFailoverController.VersionedAssignment(current, version);
+        }
+        public boolean compareAndSet(String p, int expected, PartitionAssignment next) {
+            writes++;
+            if (conflict || expected != version) return false;
+            current = next;
+            version++;
+            return true;
+        }
+        public void requireSafe(PartitionAssignment old, String candidate, List<String> replicas) {
+            proofs.incrementAndGet();
+            assertEquals("B", candidate);
+            assertEquals(Collections.singletonList("B"), replicas);
+            if (afterProof != null) afterProof.run();
+            if (!safe) throw new IllegalStateException("unproven ACK boundary");
+        }
+    }
+    private static PartitionAssignment assignment(String... replicas) {
+        PartitionAssignment a = new PartitionAssignment();
+        a.setPartitionId("P000");
+        a.setEpoch(7);
+        a.setAssignmentVersion(4);
+        a.setProtocolVersion(2);
+        a.setPrimary("A");
+        a.setReplicas(Arrays.asList(replicas));
+        a.setState("READY");
+        return a;
+    }
+    @Test public void loneSynchronizedRf2SurvivorTransitionsToNonRoutableEpoch() {
+        Fixture f = new Fixture();
+        f.live.remove("A");
+        PartitionFailoverController.Result result = f.controller().reconcile("P000");
+        assertEquals(PartitionFailoverController.Outcome.APPLIED_NOT_READY, result.getOutcome());
+        assertEquals(8, result.getNewEpoch());
+        assertEquals("B", f.current.getPrimary());
+        assertEquals(8, f.current.getEpoch());
+        assertEquals(5, f.current.getAssignmentVersion());
+        assertEquals("RECOVERING", f.current.getState());
+        assertFalse(f.current.isRoutable());
+        assertTrue(f.current.replicaNodes().isEmpty());
+        assertEquals(Collections.singletonList("A"), f.current.getLearners());
+        assertEquals(1, f.proofs.get());
+        assertEquals(1, f.writes);
+        assertEquals(0, PartitionAssignmentValidator.validate(f.current).size());
+    }
+    @Test public void previousPrimaryStillLiveCannotTriggerTransition() {
+        Fixture f = new Fixture();
+        assertEquals(PartitionFailoverController.Outcome.PRIMARY_STILL_LIVE,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals(0, f.proofs.get());
+        assertEquals(0, f.writes);
+    }
+    @Test public void lostLeaseAfterProofCannotCas() {
+        Fixture f = new Fixture();
+        f.live.remove("A");
+        f.afterProof = () -> f.leased = false;
+        assertEquals(PartitionFailoverController.Outcome.STALE_BEFORE_CAS,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals(0, f.writes);
+    }
+    @Test public void noVerifiedAckFrontierCannotCas() {
+        Fixture f = new Fixture();
+        f.live.remove("A");
+        f.safe = false;
+        assertEquals(PartitionFailoverController.Outcome.PROMOTION_UNSAFE,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals(0, f.writes);
+    }
+    @Test public void casConflictDoesNotClaimHandoff() {
+        Fixture f = new Fixture();
+        f.live.remove("A");
+        f.conflict = true;
+        assertEquals(PartitionFailoverController.Outcome.CAS_CONFLICT,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals("A", f.current.getPrimary());
+        assertEquals(7, f.current.getEpoch());
+    }
+    @Test public void noLiveStandbyFailsClosed() {
+        Fixture f = new Fixture();
+        f.live.clear();
+        assertEquals(PartitionFailoverController.Outcome.INSUFFICIENT_SYNCHRONIZED_REPLICAS,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals(0, f.writes);
+    }
+    @Test public void rf3OnlyOneSurvivorMustNotStageHandoff() {
+        Fixture f = new Fixture();
+        f.current = assignment("B", "C");
+        f.live.remove("A");
+        assertEquals(PartitionFailoverController.Outcome.INSUFFICIENT_SYNCHRONIZED_REPLICAS,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals(0, f.writes);
+    }
+    @Test public void survivorWithoutDataQuorumCannotPretendStrictRf2Ready() {
+        Fixture f = new Fixture();
+        f.live.remove("A");
+        f.controller().reconcile("P000");
+        assertFalse(f.current.isRoutable());
+        f.current.setState("READY");
+        try {
+            PartitionReplicaGroup.from(f.current,
+                    PartitionReplicaGroup.Durability.QUORUM_DURABLE,
+                    Collections.singletonMap("B", "physical-b"));
+            fail("RF1 must not advertise strict RF2 2/2");
+        } catch (IllegalArgumentException expected) {
+            // Missing RF2 voter is not an eligible strict data majority.
+        }
+    }
+    @Test public void recoveringOwnerCannotAutoReconcileSecondEpoch() {
+        Fixture f = new Fixture();
+        f.live.remove("A");
+        f.controller().reconcile("P000");
+        assertEquals(PartitionFailoverController.Outcome.STALE_BEFORE_CAS,
+                f.controller().reconcile("P000").getOutcome());
+        assertEquals(1, f.writes);
+    }
+}
