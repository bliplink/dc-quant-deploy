+package com.opentradingcore.demo;
+
+import com.app.common.partition.ZkPartitionFailoverControlPlane;
+import com.app.common.zk.ZookeeperClient;
+
+/** One-shot read-only diagnostic. It CANNOT publish a ZK grant or client ACK. */
+public final class DemoV19Rf2StrictRejoinProbe {
+    private DemoV19Rf2StrictRejoinProbe() {}
+    public static void main(String[] args)throws Exception {
+        if(args.length!=1 || !args[0].matches("CommonHaDemo[AB]"))
+            throw new IllegalArgumentException("single local node ID required");
+        String root=DemoZkFenceSource.ISOLATED_ROOT+"/harness";
+        ZookeeperClient zk=new ZookeeperClient(DemoAssignmentBootstrap.HOSTS,null,null);
+        try {
+            // Never claim/release the real failover owner's ephemeral lease.
+            try(ZkPartitionFailoverControlPlane plane=new ZkPartitionFailoverControlPlane(
+                    zk,root+"/assignments",root+"/members",root+"/rf2-auto-stage-controller","rf2-read-only-probe")) {
+                DemoV19Rf2StrictRejoinPreflight.Evidence proof=
+                        new DemoV19Rf2StrictRejoinPreflight(zk,plane,args[0]).once();
+                System.out.println("RF2_STRICT_REJOIN_CANDIDATE "+proof.summary()
+                        +" fullyProvenStrict2of2Ack=false controlMutation=false");
+            }
+        } finally {
+            zk.close();
+        }
+    }
+}
