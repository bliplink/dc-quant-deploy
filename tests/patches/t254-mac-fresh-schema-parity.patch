+#!/usr/bin/env python3
+"""Offline/static Mac cold-install schema gates; never connects to MySQL."""
+from pathlib import Path
+import unittest
+
+ROOT=Path(__file__).resolve().parents[1]
+MIG=ROOT / "mysql" / "migrations"
+REQUIRED=(
+    "20260929_system_message_location.sql",
+    "20260930_tenant_liquidity_bootstrap.sql",
+    "20261017_tenant_numeric_user_ids.sql",
+    "20261018_01_broker_tenant_sources.sql",
+    "20261018_02_broker_price_source_staging.sql",
+    "20261019_dc_symbol_tenant_identity.sql",
+    "20261019_tenant_product_data_source.sql",
+    "20261020_dc_symbol_product_display_name_128.sql",
+    "20261020_tenant_product_matching_mode.sql",
+)
+
+class MacFreshMigrationParityTest(unittest.TestCase):
+    def test_exact_required_migrations_present_and_sorted(self):
+        names=sorted(p.name for p in MIG.glob("*.sql"))
+        for name in REQUIRED:
+            with self.subTest(name=name):
+                self.assertIn(name,names)
+                self.assertGreater((MIG/name).stat().st_size,100)
+        self.assertLess(names.index(REQUIRED[3]),names.index(REQUIRED[4]))
+        self.assertLess(names.index(REQUIRED[5]),names.index(REQUIRED[6]))
+
+    def test_existing_broker_columns_are_replay_safe(self):
+        sql=(MIG/"20261018_01_broker_tenant_sources.sql").read_text()
+        for column in ("price_source","liquidity_source","source_config_version","source_switch_state"):
+            self.assertIn(column,sql)
+        self.assertGreaterEqual(sql.count("information_schema.COLUMNS"),4)
+
+    def test_symbol_and_product_source_are_replay_safe(self):
+        symbol=(MIG/"20261019_dc_symbol_tenant_identity.sql").read_text()
+        product=(MIG/"20261019_tenant_product_data_source.sql").read_text()
+        self.assertIn("DEFAULT '''' AFTER id",symbol)
+        self.assertIn("uq_dc_symbol_tenant_code",symbol)
+        self.assertIn("CREATE TABLE IF NOT EXISTS dc_tenant_data_source",product)
+        for item in ("product_name","data_source_id","idx_tenant_symbol_source",
+                     "fk_tenant_product_data_source"):
+            self.assertIn(item,product)
+        self.assertGreaterEqual(product.count("PREPARE migrate FROM @ddl"),4)
+
+    def test_install_gates_required_live_business_columns(self):
+        code=(ROOT/"deploy-saas.sh").read_text()
+        for symbol in ("core_schema_columns","liquidity_source","source_switch_state",
+                       "dc_tenant_data_source","matching_mode"):
+            self.assertIn(symbol,code)
+        self.assertIn("verify_mysql_runtime_schema",code)
+
+    def test_mysql_init_fails_closed_before_announcing_healthy(self):
+        script=(ROOT/"mysql/init/20-apply-migrations.sh").read_text()
+        health=(ROOT/"mysql/init/check-schema-ready.sh").read_text()
+        self.assertIn("/opt/saas-migrations/*.sql",script)
+        self.assertIn("set -Eeuo pipefail",script)
+        self.assertIn("dc_fresh_schema_install_status",health)
+
+if __name__=="__main__":
+    unittest.main()
