+    /** Startup-only wait for a real nonempty certified node grant.
+     * Never invokes ZooKeeper from the caller or weakens an expired grant.
+     */
+    public java.util.Map<String,NodePartitionGrantTable.Partition>
+            awaitInitialCertifiedPartitionCensus(long timeoutMillis)
+            throws IOException,InterruptedException {
+        if(timeoutMillis<100L || timeoutMillis>60000L)
+            throw new IllegalArgumentException("bounded Common census startup timeout required");
+        if(!started.get())throw new IOException("Common node controller not started");
+        final long deadline=System.nanoTime()+TimeUnit.MILLISECONDS.toNanos(timeoutMillis);
+        IOException last=null;
+        for(;;){
+            if(closed.get())throw new IOException("Common node controller closed during startup",last);
+            try {
+                java.util.Map<String,NodePartitionGrantTable.Partition> census=
+                        requireCertifiedPartitionCensus();
+                if(!census.isEmpty())return census;
+            }catch(IOException pending){last=pending;}
+            long remaining=deadline-System.nanoTime();
+            if(remaining<=0L)
+                throw new IOException("COMMON_CERTIFIED_CENSUS_STARTUP_TIMEOUT",last);
+            Thread.sleep(Math.max(1L,Math.min(50L,TimeUnit.NANOSECONDS.toMillis(remaining))));
+        }
+    }
+
     public int localPartitionCount(){return grants.partitionCount();}
