+++ b/src/test/java/com/app/common/replication/DurableWalCustodyReceiptCrashCompletionTest.java
@@ -0,0 +1,134 @@
+package com.app.common.replication;
+
+import java.io.IOException;
+import java.nio.file.*;
+import java.security.*;
+import java.util.*;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+/**
+ * Exercises the exact P210 crash window: quorum WAL & custody HEAD at N,
+ * independent post-install Receipt Ledger at N-1. Normal recovery must reject;
+ * explicit offline recovery demands the older TWO-RSA proof and NEW signatures.
+ */
+public final class DurableWalCustodyReceiptCrashCompletionTest {
+    @Rule public TemporaryFolder temp = new TemporaryFolder();
+    private static final String OLD_HASH =
+        "1111111111111111111111111111111111111111111111111111111111111111";
+    private static final String NEW_HASH =
+        "2222222222222222222222222222222222222222222222222222222222222222";
+
+    private static final class Fixture implements AutoCloseable {
+        final KeyPair[] keys = new KeyPair[2];
+        final DurableWalCommitQuorum.Membership membership;
+        final DurableWalCommitQuorum.Certificate oldCert, newCert;
+        final DurableWalCertificateCustody a, b;
+        final Path ledgerPath;
+        final Path archivePath;
+        final List<DurableWalCustodyQuorum.Receipt> oldReceipts, newReceipts;
+        final DurableWalCommitQuorum.LocalDurability wal = (epoch, sequence)->{
+            if(epoch!=2 || (sequence!=41 && sequence!=42))
+                throw new IOException("no physically signed WAL");
+            return sequence==41 ? OLD_HASH : NEW_HASH;
+        };
+        Fixture(TemporaryFolder temporary)throws Exception {
+            KeyPairGenerator generator=KeyPairGenerator.getInstance("RSA");
+            generator.initialize(2048);
+            keys[0]=generator.generateKeyPair();
+            keys[1]=generator.generateKeyPair();
+            membership=new DurableWalCommitQuorum.Membership("OrderSvr","P210",
+                "NodeA",2,2,Arrays.asList(
+                    new DurableWalCommitQuorum.Member("NodeA","physicalA",keys[0].getPublic()),
+                    new DurableWalCommitQuorum.Member("NodeB","physicalB",keys[1].getPublic())));
+            oldCert=cert(41);
+            newCert=cert(42);
+            a=new DurableWalCertificateCustody(temporary.newFolder("a").toPath(),
+                membership,wal,m-> {});
+            b=new DurableWalCertificateCustody(temporary.newFolder("b").toPath(),
+                membership,wal,m-> {});
+            ledgerPath=temporary.newFolder("receipt-ledger").toPath();
+            archivePath=temporary.newFolder("independent-evidence").toPath()
+                .resolve("original-old-receipts.bin");
+            a.install(oldCert);
+            b.install(oldCert);
+            oldReceipts=Arrays.asList(a.signInstalled("NodeA",keys[0].getPrivate()),
+                b.signInstalled("NodeB",keys[1].getPrivate()));
+            try(DurableWalCustodyReceiptLedger old=new DurableWalCustodyReceiptLedger(
+                    ledgerPath,membership,b)) {
+                assertEquals(41L,old.persist(oldCert,oldReceipts));
+            }
+            Files.copy(ledgerPath.resolve("receipt-quorum.bin"),archivePath);
+            a.install(newCert);
+            b.install(newCert);
+            newReceipts=Arrays.asList(a.signInstalled("NodeA",keys[0].getPrivate()),
+                b.signInstalled("NodeB",keys[1].getPrivate()));
+        }
+        DurableWalCommitQuorum.Certificate cert(long seq)throws Exception {
+            List<DurableWalCommitQuorum.Receipt> votes=new ArrayList<>();
+            votes.add(DurableWalCommitQuorum.sign(membership,"NodeA",seq,wal,keys[0].getPrivate()));
+            votes.add(DurableWalCommitQuorum.sign(membership,"NodeB",seq,wal,keys[1].getPrivate()));
+            return DurableWalCommitQuorum.verify(membership,seq,
+                seq==41 ? OLD_HASH : NEW_HASH,votes);
+        }
+        public void close()throws Exception {b.close();a.close();}
+    }
+
+    @Test public void normalRestartRejectsPartialCrashAndExplicitRealDualRsaRestores()
+            throws Exception {
+        try(Fixture f=new Fixture(temp)){
+            try {
+                new DurableWalCustodyReceiptLedger(f.ledgerPath,f.membership,f.b);
+                fail("normal Common recovery silently accepted incomplete custody");
+            }catch(IOException expected){
+                assertEquals("receipt ledger head != physical custody",expected.getMessage());
+            }
+            try(DurableWalCustodyReceiptLedger recovery=
+                    DurableWalCustodyReceiptLedger.openForCertifiedCrashCompletion(
+                        f.ledgerPath,f.membership,f.b,f.oldCert,f.archivePath)){
+                assertEquals(42L,recovery.persist(f.newCert,f.newReceipts));
+                assertEquals(2,recovery.requireRecovered(f.newCert).size());
+            }
+            try(DurableWalCustodyReceiptLedger restarted=new DurableWalCustodyReceiptLedger(
+                    f.ledgerPath,f.membership,f.b)){
+                assertEquals(2,restarted.requireRecovered(f.newCert).size());
+            }
+            assertTrue(Files.size(f.archivePath)>0L);
+        }
+    }
+
+    @Test public void singleRsaOrMissingArchivedOriginalCannotCompleteCrash()
+            throws Exception {
+        try(Fixture f=new Fixture(temp)){
+            byte[] original=Files.readAllBytes(f.ledgerPath.resolve("receipt-quorum.bin"));
+            try(DurableWalCustodyReceiptLedger recovering=
+                    DurableWalCustodyReceiptLedger.openForCertifiedCrashCompletion(
+                        f.ledgerPath,f.membership,f.b,f.oldCert,f.archivePath)){
+                try {
+                    recovering.persist(f.newCert,Collections.singletonList(f.newReceipts.get(0)));
+                    fail("single custodian must not complete physical quorum");
+                }catch(IOException|IllegalArgumentException expected){}
+            }
+            assertArrayEquals(original,Files.readAllBytes(f.ledgerPath.resolve("receipt-quorum.bin")));
+            Files.delete(f.archivePath);
+            try {
+                DurableWalCustodyReceiptLedger.openForCertifiedCrashCompletion(
+                    f.ledgerPath,f.membership,f.b,f.oldCert,f.archivePath);
+                fail("missing archived old quorum proof accepted");
+            }catch(IOException expected){}
+        }
+    }
+
+    @Test public void mismatchedPriorCertificateIsNotRecoveryAuthority()
+            throws Exception {
+        try(Fixture f=new Fixture(temp)){
+            try {
+                DurableWalCustodyReceiptLedger.openForCertifiedCrashCompletion(
+                    f.ledgerPath,f.membership,f.b,f.newCert,f.archivePath);
+                fail("wrong prior epoch/sequence accepted");
+            }catch(IOException expected){}
+        }
+    }
+}
