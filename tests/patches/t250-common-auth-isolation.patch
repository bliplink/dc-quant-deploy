+    /** Per-partition read/snapshot gate. A fault on an unrelated shard must
+     * not block a healthy one, but the selected shard still checks its real
+     * Common physical grant and local certified custody writer state. */
+    public void requireAuthenticatedPartitionRole(String partition)throws Exception {
+        if(closed || !started)throw new IOException("Common node unavailable");
+        java.util.Map<String,NodePartitionGrantTable.Partition> census=
+                verifiedNodeControl.requireCertifiedPartitionCensus();
+        if(census.size()!=partitions.size())
+            throw new IOException("Common certified node census incomplete");
+        CommonCertifiedPartitionRuntime selected=partitions.get(partition);
+        if(selected==null || !census.containsKey(partition))
+            throw new IOException("Common selected partition absent from signed census");
+        selected.requireCurrentRole();
+    }
+
