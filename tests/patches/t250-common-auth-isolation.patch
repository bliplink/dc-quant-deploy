+package com.app.common.replication;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.*;
+import java.util.concurrent.TimeUnit;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+/** Fault isolation: one ambiguous WAL shard must not halt all peer shards. */
+public final class CommonCertifiedPartitionIsolationTest {
+    @Rule public TemporaryFolder temporary=new TemporaryFolder();
+
+    @Test public void onePoisonedShardMustNotRevokeOtherAuthenticatedWriters()
+            throws Exception {
+        KeyPairGenerator generator=KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        KeyPair a=generator.generateKeyPair(),b=generator.generateKeyPair();
+        String service="OrderSvr",primary="NodeA",replica="NodeB";
+        Map<String,NodePartitionGrantTable.Partition> routes=new HashMap<>();
+        for(String p:Arrays.asList("P210","P211"))
+            routes.put(p,new NodePartitionGrantTable.Partition(p,2,primary,replica,
+                    DurableWalAckPolicy.STRICT_QUORUM));
+        NodePartitionGrantTable grants=new NodePartitionGrantTable(primary,
+                System::nanoTime,batch->{
+                    if(batch.quorumProof()[0]!=42)
+                        throw new IOException("untrusted Common test grant");
+                },256,TimeUnit.SECONDS.toNanos(15));
+        try(NodeClusterControlManager manager=new NodeClusterControlManager(
+                primary,identity->new NodePartitionGrantTable.Batch(
+                    primary,2,System.nanoTime(),TimeUnit.SECONDS.toNanos(15),
+                    0L,routes,new byte[]{42}),grants,1000L);
+            DirectNettyReplicationTransport tcp=new DirectNettyReplicationTransport(
+                    500,65536)) {
+            manager.refresh(); // a real verified synthetic test grant, no business I/O
+            manager.start();
+            manager.awaitInitialCertifiedPartitionCensus(1500);
+            Path storage=temporary.newFolder("isolated-physical-shards").toPath();
+            Map<String,CommonCertifiedPartitionRuntime> shards=new HashMap<>();
+            Map<String,ReplicationEndpoint> peers=Collections.singletonMap(replica,
+                    new ReplicationEndpoint(replica,"127.0.0.1",1));
+            for(String part:Arrays.asList("P210","P211")){
+                DurableWalCommitQuorum.Membership member=new DurableWalCommitQuorum.Membership(
+                    service,part,primary,2,2,Arrays.asList(
+                      new DurableWalCommitQuorum.Member(primary,"physical-A",a.getPublic()),
+                      new DurableWalCommitQuorum.Member(replica,"physical-B",b.getPublic())));
+                DurableWalCertificateCustody.Authority authority=old->{
+                    if(old.epoch!=2 || !old.partition.equals(part))
+                        throw new IOException("stale Epoch");
+                    manager.requirePrimary(part,2,DurableWalAckPolicy.STRICT_QUORUM)
+                        .requireCurrent();
+                };
+                shards.put(part,CommonCertifiedPartitionRuntime.open(storage,member,
+                    primary,a.getPrivate(),true,manager,authority,tcp,peers,500L));
+            }
+            try(CommonCertifiedNodeRuntime node=new CommonCertifiedNodeRuntime(
+                    service,primary,manager,2,shards,"127.0.0.1",0)){
+                node.start();
+                assertEquals(2,node.requirePrimaryRegistry().size());
+                // The offline B endpoint refuses physical WAL fsync. P210
+                // must be fenced, not acknowledged.
+                try{
+                    node.requirePrimaryRegistry().commit("P210",
+                            (p,e,n)->"SIMULATED_UNKNOWN_OUTCOME".getBytes("UTF-8"));
+                    fail("unreachable physical replica received client ACK");
+                }catch(Exception expected){}
+                try {shards.get("P210").requireCertifiedPrimaryWriter();
+                    fail("Common exposed poisoned physical writer");}
+                catch(IOException expected){assertTrue(expected.getMessage().contains("poisoned"));}
+                try{node.requireAuthenticatedReady();
+                    fail("full-node readiness must still detect poison");}
+                catch(IOException expected){assertTrue(expected.getMessage().contains("certified"));}
+                // This used to fail because requirePrimaryRegistry() globally
+                // called requireAuthenticatedReady() on all 256 partitions.
+                CertifiedBusinessCommandRegistry surviving=node.requirePrimaryRegistry();
+                assertNotNull(surviving.require("P211"));
+                node.requireAuthenticatedPartitionRole("P211");
+                try{surviving.require("P210");fail("poisoned P210 was re-admitted");}
+                catch(IOException expected){assertTrue(expected.getMessage().contains("P210"));}
+                assertEquals(0L,shards.get("P211").forcedSequence());
+            }
+        }
+    }
+}