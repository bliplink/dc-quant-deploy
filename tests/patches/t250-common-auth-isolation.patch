diff --git a/src/test/java/com/app/common/replication/CertifiedBusinessCommandPreflightFailureTest.java b/src/test/java/com/app/common/replication/CertifiedBusinessCommandPreflightFailureTest.java
new file mode 100644
index 0000000..b2858a1
--- /dev/null
+++ b/src/test/java/com/app/common/replication/CertifiedBusinessCommandPreflightFailureTest.java
@@ -0,0 +1,148 @@
+package com.app.common.replication;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+/** Regression: rejected pre-WAL grants are NOT permanent WAL poisoning. */
+public final class CertifiedBusinessCommandPreflightFailureTest {
+    @Rule public TemporaryFolder temporary=new TemporaryFolder();
+
+    private static final class Case implements AutoCloseable {
+        final AtomicBoolean grant=new AtomicBoolean(true);
+        final AtomicBoolean authority=new AtomicBoolean(true);
+        final AtomicInteger appendCount=new AtomicInteger();
+        final AtomicInteger poisonedTransport=new AtomicInteger();
+        final DurableWalCommitQuorum.Membership membership;
+        final DurableWalCommitIndex index;
+        final DurableWalCertificateCustody custody;
+        final DurableWalCustodyReceiptLedger ledger;
+        final CertifiedBusinessCommandBoundary boundary;
+        volatile boolean throwSevereError;
+        Case(Path base)throws Exception {
+            KeyPairGenerator maker=KeyPairGenerator.getInstance("RSA");
+            maker.initialize(2048);
+            KeyPair a=maker.generateKeyPair(),b=maker.generateKeyPair();
+            membership=new DurableWalCommitQuorum.Membership(
+                "OrderSvr","P210","A",2L,2L,Arrays.asList(
+                    new DurableWalCommitQuorum.Member("A","hostA",a.getPublic()),
+                    new DurableWalCommitQuorum.Member("B","hostB",b.getPublic())));
+            DurableWalCommitQuorum.LocalDurability empty=(epoch,seq)->{
+                throw new IOException("no WAL written");
+            };
+            DurableWalCertificateCustody.Authority epochAuth=old->{
+                if(!authority.get())throw new IOException("old epoch authorization temporarily missing");
+            };
+            index=new DurableWalCommitIndex(base.resolve("index"),membership);
+            custody=new DurableWalCertificateCustody(base.resolve("custody"),membership,empty,epochAuth);
+            ledger=new DurableWalCustodyReceiptLedger(base.resolve("ledger"),membership,custody);
+            CertifiedBusinessCommandBoundary.PhysicalTransport physical=
+                new CertifiedBusinessCommandBoundary.PhysicalTransport() {
+                    public DurableWalGroupCommit.Writer writer() {
+                        return new DurableWalGroupCommit.Writer(){
+                            public void appendUnforced(long epoch,long seq,byte[] bytes)throws Exception {
+                                appendCount.incrementAndGet();
+                                if(throwSevereError)throw new AssertionError("synthetic VM write failure");
+                                throw new IOException("synthetic disk append failure");
+                            }
+                            public void forceBatch()throws Exception {
+                                throw new IOException("must not force");
+                            }
+                            public void publishCommitted(long epoch,long seq,byte[] bytes){}
+                            public void poison(Throwable failure){poisonedTransport.incrementAndGet();}
+                        };
+                    }
+                    public void requireCleanCertifiedHead(long epoch,long seq)throws Exception {
+                        if(epoch!=2L || seq!=0L)throw new IOException("dirty WAL");
+                    }
+                    public void requireFsyncedRecord(long epoch,long seq,byte[] command){}
+                    public Collection<DurableWalCommitQuorum.Receipt> collectSignedWalFsyncReceipts(
+                        long epoch,long seq,String hash){return Collections.emptyList();}
+                    public Collection<DurableWalCustodyQuorum.Receipt> installAndReceiptPhysicalCustody(
+                        DurableWalCommitQuorum.Certificate head){return Collections.emptyList();}
+                    public void poison(Throwable failure){poisonedTransport.incrementAndGet();}
+                };
+            boundary=new CertifiedBusinessCommandBoundary(membership,index,ledger,empty,epochAuth,
+                (part,epoch)->{if(!grant.get())throw new IOException("certified Common primary lease expired");},
+                physical);
+        }
+        public void close()throws Exception {
+            ledger.close();custody.close();index.close();
+        }
+    }
+
+    private static void assertCommitPhase(Throwable failure,String expectedStage,boolean wrote){
+        boolean found=false;
+        for(Throwable suppressed:failure.getSuppressed()){
+            String detail=suppressed.getMessage();
+            if(detail!=null && detail.contains("phase="+expectedStage)
+                    && detail.contains("walWriteStarted="+wrote))found=true;
+        }
+        assertTrue("missing safe Common physical commit phase diagnostic",found);
+    }
+
+    @Test public void transientLeaseDenialBeforeWalDoesNotPoisonAndNextRequestRechecks()
+            throws Exception {
+        try(Case f=new Case(temporary.newFolder().toPath())) {
+            f.grant.set(false);
+            try { f.boundary.commit("ONE".getBytes("UTF-8"));fail("expired grant accepted"); }
+            catch(IOException expected){
+                assertTrue(expected.getMessage().contains("lease"));
+                assertCommitPhase(expected,"PREFLIGHT_PRIMARY_GRANT",false);
+            }
+            assertEquals(0,f.appendCount.get());
+            assertEquals(0,f.poisonedTransport.get());
+            assertFalse(f.boundary.isPoisoned());
+            f.grant.set(true);
+            try { f.boundary.commit("TWO".getBytes("UTF-8"));fail("simulated disk failure not rejected"); }
+            catch(IOException expected){
+                assertTrue(expected.getMessage().contains("append"));
+                assertCommitPhase(expected,"WAL_APPEND_FSYNC",true);
+            }
+            assertEquals(1,f.appendCount.get());
+            assertTrue(f.boundary.isPoisoned());
+            assertTrue(f.poisonedTransport.get()>0);
+        }
+    }
+
+    @Test public void revokedOldEpochBeforeWalDoesNotPoison()
+            throws Exception {
+        try(Case f=new Case(temporary.newFolder().toPath())){
+            f.authority.set(false);
+            try {f.boundary.commit("NO_WRITE".getBytes("UTF-8"));fail("old epoch accepted");}
+            catch(IOException expected){
+                assertTrue(expected.getMessage().contains("authorization"));
+                assertCommitPhase(expected,"PREFLIGHT_EPOCH_AUTHORITY",false);
+            }
+            assertFalse(f.boundary.isPoisoned());
+            assertEquals(0,f.poisonedTransport.get());
+            assertEquals(0,f.appendCount.get());
+        }
+    }
+
+    @Test public void severeErrorAfterWalEntryMustFenceWriter()
+            throws Exception {
+        try(Case f=new Case(temporary.newFolder().toPath())){
+            f.throwSevereError=true;
+            try {f.boundary.commit("VM_FAILURE".getBytes("UTF-8"));fail("post-entry failure accepted");}
+            catch(AssertionError expected){
+                assertTrue(expected.getMessage().contains("VM"));
+                assertCommitPhase(expected,"WAL_APPEND_FSYNC",true);
+            }
+            assertEquals(1,f.appendCount.get());
+            assertTrue(f.boundary.isPoisoned());
+            assertTrue(f.poisonedTransport.get()>0);
+        }
+    }
+}
