diff --git a/src/main/java/com/app/common/replication/CommonCertifiedNodeRuntime.java b/src/main/java/com/app/common/replication/CommonCertifiedNodeRuntime.java
index 17789c0..e7fd871 100644
--- a/src/main/java/com/app/common/replication/CommonCertifiedNodeRuntime.java
+++ b/src/main/java/com/app/common/replication/CommonCertifiedNodeRuntime.java
@@ -20,6 +20,8 @@ public final class CommonCertifiedNodeRuntime implements AutoCloseable {
     private final Map<String,CommonCertifiedPartitionRuntime> partitions;
     private final CertifiedBusinessCommandRegistry primaryWrites;
     private final DirectNettyReplicationServer server;
+    // Common owns its automatic control loop; this never invents READY.
+    private final Map<String,CommonCertifiedFailoverWatch> failoverWatches=new HashMap<>();
     private boolean started,closed;
 
     public CommonCertifiedNodeRuntime(String service,String node,
@@ -84,6 +86,30 @@ public final class CommonCertifiedNodeRuntime implements AutoCloseable {
         server.start();
         started=true;
     }
+    /** Reuse the existing Common failover watcher for a local replica.
+     * The node owns its lifecycle; an E2 stage is NOT a READY grant.
+     * No business state or second election mechanism is introduced. */
+    public synchronized CommonCertifiedFailoverWatch armAutomaticFailoverWatch(
+            String partition,CommonCertifiedFailoverCoordinator coordinator,
+            int periodMillis,
+            CommonCertifiedFailoverCoordinator.LocalReplicaCatchupProof catchup)
+            throws Exception {
+        if(closed || !started)
+            throw new IOException("Common node must be fully started before auto failover watch");
+        CommonCertifiedPartitionRuntime selected=partitions.get(partition);
+        if(selected==null || selected.primary())
+            throw new IOException("Common automatic failover requires an installed local replica");
+        if(failoverWatches.containsKey(partition))
+            throw new IOException("Common automatic failover watch already armed for partition");
+        selected.requireCurrentRole();
+        CommonCertifiedFailoverWatch watch=new CommonCertifiedFailoverWatch(
+                Objects.requireNonNull(coordinator,"Common authenticated failover coordinator"),
+                partition,periodMillis,catchup);
+        failoverWatches.put(partition,watch);
+        try {watch.start();}
+        catch(RuntimeException failure){failoverWatches.remove(partition);watch.close();throw failure;}
+        return watch;
+    }
     /** A real Common lease check is required before exposing any business. */
     public synchronized void requireAuthenticatedReady()throws Exception {
         if(closed)throw new IOException("Common certified runtime closed");
@@ -126,6 +152,8 @@ public final class CommonCertifiedNodeRuntime implements AutoCloseable {
     public int primaryPartitionCount(){return primaryWrites==null?0:primaryWrites.size();}
     @Override public synchronized void close()throws Exception {
         if(closed)return;closed=true;
+        for(CommonCertifiedFailoverWatch watch:failoverWatches.values())watch.close();
+        failoverWatches.clear();
         server.close();
         Exception first=null;
         for(CommonCertifiedPartitionRuntime p:partitions.values()){
