+package com.app.common.replication;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.Arrays;
+import java.util.zip.CRC32;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** Authenticated historical cold E2, not merely unsigned incremental WAL. */
+public final class CommonCertifiedE2LargeColdHistoryTest {
+    private static byte[] wal(int length)throws Exception{
+        ByteArrayOutputStream output=new ByteArrayOutputStream();
+        for(int i=1;i<=length;i++){
+            byte[] payload=("test-order-after-"+i).getBytes("UTF-8");
+            ByteBuffer check=ByteBuffer.allocate(16+payload.length);
+            check.putLong(2).putLong(i).put(payload);
+            CRC32 crc=new CRC32();crc.update(check.array());
+            ByteBuffer wire=ByteBuffer.allocate(28+payload.length);
+            wire.putInt(0x43425731).putLong(2).putLong(i)
+                    .putInt(payload.length).putInt((int)crc.getValue()).put(payload);
+            output.write(wire.array());
+        }
+        return output.toByteArray();
+    }
+    @Test public void historicalCertifiedColdReplays4105FramesAcrossWindowBoundary()
+            throws Exception{
+        Path root=Files.createTempDirectory("certified-cold-4105");
+        Path path=root.resolve("business.wal");
+        Files.write(path,wal(4105));
+        KeyPairGenerator generator=KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
