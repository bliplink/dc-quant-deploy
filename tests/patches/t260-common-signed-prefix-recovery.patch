@@ -0,0 +1,82 @@
+package com.app.common.replication;
+
+import static org.junit.Assert.*;
+import java.io.IOException;
+import java.nio.file.*;
+import java.util.*;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+/** Signed survivor recovery consumes only the authenticated prefix, never dirty suffix. */
+public final class CommonHistoricalCertifiedPrefixWithTailTest {
+    @Rule public TemporaryFolder dir=new TemporaryFolder();
+
+    @Test public void historicalReadOnlyCanReplayTwoCertifiedRecordsButNeverAdoptTail() throws Exception {
+        Path walFile=dir.getRoot().toPath().resolve("P002/E2/business.wal");
+        byte[] a="any-business-state-one".getBytes("UTF-8");
+        byte[] b="any-business-state-two".getBytes("UTF-8");
+        byte[] extra="not-committed-after-custody".getBytes("UTF-8");
+        String signed;
+        try(CommonFileBusinessWal owner=new CommonFileBusinessWal(walFile,2)){
+            DurableWalGroupCommit.forceThenPublish(2,1,Collections.singletonList(a),owner.writer());
+            DurableWalGroupCommit.forceThenPublish(2,2,Collections.singletonList(b),owner.writer());
+            signed=owner.requireFsyncedPrefix(2,2);
+            DurableWalGroupCommit.forceThenPublish(2,3,Collections.singletonList(extra),owner.writer());
+            assertEquals(3,owner.forcedSequence());
+            try{owner.requireCleanCertifiedHead(2,2);fail("dirty tail adopted for writable ACK");}
+            catch(IOException expected){}
+        }
+        byte[] original=Files.readAllBytes(walFile);
+        try(CommonFileBusinessWal viewer=CommonFileBusinessWal.openExistingReadOnly(walFile,2)){
+            viewer.requireHistoricalSignedPrefix(2,2,signed);
+            List<CommonFileBusinessWal.CommittedWalFrame> certified=
+                viewer.readCertifiedFrames(2,2,signed,8,65536);
+            assertEquals(2,certified.size());
+            assertArrayEquals(a,certified.get(0).bytes());
+            assertArrayEquals(b,certified.get(1).bytes());
+            List<CommonFileBusinessWal.CommittedWalFrame> window=
+                viewer.readCertifiedWindow(2,2,signed,0,2,64L*1024L*1024L);
+            assertEquals(2,window.size());
+            assertEquals(2,window.get(1).sequence);
+            try{viewer.readCertifiedFrames(2,3,signed,8,65536);
+                fail("unsigned tail replayed as authenticated");}
+            catch(IOException expected){}
+            try{viewer.requireFsyncedPrefix(2,2);
+                fail("historical observer issued new ACK");}
+            catch(IOException expected){}
+            try{viewer.requireHistoricalSignedPrefix(2,2,
+                 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
+                fail("wrong RSA-certified SHA accepted");}
+            catch(IOException expected){}
+        }
+        assertArrayEquals("Original WAL including extra tail must remain untouched",
+                original,Files.readAllBytes(walFile));
+    }
+
+    @Test public void corruptedCommittedPrefixCannotBeAuthenticatedByValidUnsignedTail()throws Exception{
+        Path walFile=dir.getRoot().toPath().resolve("P003/E2/business.wal");
+        String signed;
+        try(CommonFileBusinessWal owner=new CommonFileBusinessWal(walFile,2)){
+            DurableWalGroupCommit.forceThenPublish(2,1,
+                Collections.singletonList("trusted".getBytes("UTF-8")),owner.writer());
+            signed=owner.requireFsyncedPrefix(2,1);
+            DurableWalGroupCommit.forceThenPublish(2,2,
+                Collections.singletonList("extra".getBytes("UTF-8")),owner.writer());
+        }
+        byte[] original=Files.readAllBytes(walFile);
+        // Physical bytes have valid CRC/framing; a different purported HEAD is
+        // still rejected because caller must carry exact independently signed SHA.
+        try(CommonFileBusinessWal viewer=CommonFileBusinessWal.openExistingReadOnly(walFile,2)){
+            try{viewer.requireHistoricalSignedPrefix(2,1,
+                    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
+                fail("forged certified prefix accepted");}
+            catch(IOException expected){}
+            viewer.requireHistoricalSignedPrefix(2,1,signed);
+            try{viewer.readCertifiedWindow(2,2,signed,0,2,64L*1024L*1024L);
+                fail("unverified unsigned terminal seq accepted");}
+            catch(IOException expected){}
+        }
+        assertArrayEquals(original,Files.readAllBytes(walFile));
+    }
+}
