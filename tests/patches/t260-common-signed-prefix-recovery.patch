+                ||seq>forcedSequence ||signedSha==null
+                ||!signedSha.matches("[a-f0-9]{64}"))
+            throw new IOException("historical read-only WAL lacks certified HEAD");
+        final long length=file.size();
+        if(seq==forcedSequence) {
+            if(!signedSha.equals(forcedHash))
+                throw new IOException("historical read-only WAL HEAD signature mismatch");
+            return length;
+        }
+        // Constructor already checks full-file sequence, CRC and framing,
+        // including the uncertified suffix. Seek to the exact frame boundary
+        // and hash only the independent certificate's committed prefix.
+        long offset=0;
+        for(long n=1;n<=seq;n++){
+            if(length-offset<HEADER)
+                throw new IOException("certified prefix missing physical WAL header");
+            ByteBuffer h=ByteBuffer.allocate(HEADER);
+            readExactly(h,offset);h.flip();
+            int magic=h.getInt();long originalEpoch=h.getLong(),originalSeq=h.getLong();
+            int size=h.getInt();h.getInt();
+            if(magic!=MAGIC ||originalEpoch!=e ||originalSeq!=n
+                    ||size<=0 ||size>MAX ||length-offset-HEADER<size)
+                throw new IOException("certified prefix invalid original WAL frame");
+            offset+=HEADER+size;
+        }
+        MessageDigest hash=MessageDigest.getInstance("SHA-256");
+        ByteBuffer window=ByteBuffer.allocate(32768);
+        for(long pos=0;pos<offset;){
+            window.clear();window.limit((int)Math.min(window.capacity(),offset-pos));
+            int read=file.read(window,pos);
+            if(read<=0)throw new IOException("short certified prefix read");
+            hash.update(window.array(),0,read);pos+=read;
+        }
+        if(file.size()!=length ||!signedSha.equals(hex(hash.digest())))
+            throw new IOException("historical original WAL certified prefix SHA mismatch");
+        return offset;
     }
 
