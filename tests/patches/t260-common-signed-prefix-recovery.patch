diff --git a/src/main/java/com/app/common/replication/CommonCertifiedE2ReplicaHistory.java b/src/main/java/com/app/common/replication/CommonCertifiedE2ReplicaHistory.java
new file mode 100644
index 0000000..b3ae1a5
--- /dev/null
+++ b/src/main/java/com/app/common/replication/CommonCertifiedE2ReplicaHistory.java
@@ -0,0 +1,135 @@
+package com.app.common.replication;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * E2+ cold member HISTORY INPUT ONLY. The signed WAL/custody is immutable
+ * original evidence; validating it cannot authorize service READY, leader,
+ * a client ACK or skip a business state-machine replay.
+ *
+ * At an E2 member restart, business state MUST replay these frames and
+ * reconcile its exact state / external projection before any serving grant.
+ * Current live ZK grants / old-owner fencing are independent prerequisites.
+ */
+public final class CommonCertifiedE2ReplicaHistory {
+    private CommonCertifiedE2ReplicaHistory() {}
+
+    public static final class Frame {
+        public final long epoch, sequence;
+        private final byte[] payload;
+        Frame(long epoch,long sequence,byte[] payload) {
+            this.epoch=epoch;
+            this.sequence=sequence;
+            this.payload=payload.clone();
+        }
+        public byte[] payload(){return payload.clone();}
+    }
+    public static final class Verified {
+        public final String service,partition,sourceReplica,sha256;
+        public final long epoch,committedSequence;
+        public final List<Frame> frames;
+        Verified(DurableWalCommitQuorum.Membership membership,String replica,
+                 DurableWalCommitQuorum.Certificate cert,List<Frame> raw) {
+            service=membership.service;
+            partition=membership.partition;
+            sourceReplica=replica;
+            epoch=membership.epoch;
+            committedSequence=cert.committedSequence;
+            sha256=cert.commitPrefixSha256;
+            frames=Collections.unmodifiableList(new ArrayList<Frame>(raw));
+        }
+        /** Deliberately never grants serving/ACK. */
+        public boolean authorizesReady(){return false;}
+    }
+
+    public static Verified openExistingReadOnly(Path physicalReplicaEpochRoot,
+            DurableWalCommitQuorum.Membership pinnedCurrentZkMembership,
+            String originalPhysicalReplica,int maxRecords,long maxPayloadBytes)
+            throws Exception {
+        if(physicalReplicaEpochRoot==null || !physicalReplicaEpochRoot.isAbsolute()
+                ||Files.isSymbolicLink(physicalReplicaEpochRoot)
+                ||!Files.isDirectory(physicalReplicaEpochRoot,LinkOption.NOFOLLOW_LINKS)
+                ||pinnedCurrentZkMembership==null
+                ||pinnedCurrentZkMembership.epoch<2
+                ||pinnedCurrentZkMembership.members.size()!=2
+                ||originalPhysicalReplica==null
+                ||!pinnedCurrentZkMembership.members.containsKey(originalPhysicalReplica)
+                ||maxRecords<1 ||maxRecords>4096
+                ||maxPayloadBytes<1 ||maxPayloadBytes>64L*1024*1024)
+            throw new IOException("cold E2 replay requires a physically pinned A/B member and bounded current quorum");
+        Path originalWal=physicalReplicaEpochRoot.resolve("business.wal");
+        Path originalCustody=physicalReplicaEpochRoot.resolve("custody");
+        if(Files.isSymbolicLink(originalWal)||Files.isSymbolicLink(originalCustody)
+                ||!Files.isRegularFile(originalWal,LinkOption.NOFOLLOW_LINKS)
+                ||!Files.isDirectory(originalCustody,LinkOption.NOFOLLOW_LINKS))
+            throw new IOException("missing original physical replica E2 WAL/custody");
+        try(CommonFileBusinessWal wal=CommonFileBusinessWal.openExistingReadOnly(
+                    originalWal,pinnedCurrentZkMembership.epoch);
+            DurableWalCertificateCustody custody=
+                    DurableWalCertificateCustody.openExistingReadOnly(
+                        originalCustody,pinnedCurrentZkMembership,wal)) {
+            DurableWalCommitQuorum.Certificate certified=custody.highestVerified();
+            if(certified==null||certified.committedSequence<1
+                    ||certified.committedSequence>wal.forcedSequence()
+                    ||certified.epoch!=pinnedCurrentZkMembership.epoch
+                    ||certified.votes.size()!=2
+                    ||!pinnedCurrentZkMembership.digest.equals(certified.membershipSha256))
+                throw new IOException("cold E2 replay original signed committed HEAD missing");
+            // A complete original WAL can include a physically fsynced frame
+            // that never achieved the dual-signed Common committed HEAD.
+            // It remains immutable evidence, not a candidate for recovery.
+            // The custody reader verifies the signed prefix SHA exactly;
+            // only [1..certified.committedSequence] can enter domain replay.
+            wal.requireHistoricalSignedPrefix(certified.epoch,
+                    certified.committedSequence,certified.commitPrefixSha256);
+            Set<String> independent=new HashSet<String>();
+            for(DurableWalCommitQuorum.Receipt receipt:certified.votes)
+                if(!independent.add(receipt.node)
+                        ||!pinnedCurrentZkMembership.members.containsKey(receipt.node))
+                    throw new IOException("cold E2 replay original dual independent physical votes absent");
+            if(independent.size()!=2)
+                throw new IOException("cold E2 replay required both independently signed voters");
+            // maxRecords caps each independently checked window, NOT the
+            // total lifetime commit index. The authoritative HEAD remains
+            // the same RSA quorum certificate for *every* window.
+            if(certified.committedSequence>Integer.MAX_VALUE)
+                throw new IOException("cold E2 requires a certified snapshot for giant history");
+            long maxSlotsByMemory=Math.max(1L,maxPayloadBytes/64L);
+            if(certified.committedSequence>maxSlotsByMemory)
+                throw new IOException("cold E2 state history exceeds safe in-memory cap; certified snapshot required");
+            List<Frame> frames=new ArrayList<Frame>();
+            long cursor=0,retainedBytes=0;
+            while(cursor<certified.committedSequence){
+                List<CommonFileBusinessWal.CommittedWalFrame> chunk=
+                        wal.readCertifiedWindow(pinnedCurrentZkMembership.epoch,
+                                certified.committedSequence,certified.commitPrefixSha256,
+                                cursor,maxRecords,maxPayloadBytes);
+                if(chunk.isEmpty()||chunk.size()>maxRecords)
+                    throw new IOException("cold E2 authenticated window missing");
+                for(CommonFileBusinessWal.CommittedWalFrame record:chunk){
+                    if(record.epoch!=pinnedCurrentZkMembership.epoch
+                            ||record.sequence!=cursor+1)
+                        throw new IOException("cold E2 authenticated WAL sequence gap");
+                    byte[] payload=record.bytes();
+                    if(retainedBytes>maxPayloadBytes-payload.length)
+                        throw new IOException("cold E2 history exceeds bounded payload; snapshot required");
+                    retainedBytes+=payload.length;
+                    frames.add(new Frame(record.epoch,record.sequence,payload));
+                    cursor++;
+                }
+            }
+            if(cursor!=certified.committedSequence)
+                throw new IOException("cold E2 authenticated history is not contiguous");
+            return new Verified(pinnedCurrentZkMembership,originalPhysicalReplica,certified,frames);
+        }
+    }
+}
