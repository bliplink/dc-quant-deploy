+package com.app.common.replication;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+/** Read-only on-disk operator diagnostic; cannot make certificates or write WAL. */
+public final class CommonHistoricalPrefixPhysicalProbe {
+    public static void main(String[] args)throws Exception{
+        if(args.length!=4)throw new IllegalArgumentException("walPath epoch signedSeq signedSha");
+        Path original=Paths.get(args[0]);
+        long e=Long.parseLong(args[1]),seq=Long.parseLong(args[2]);
+        try(CommonFileBusinessWal reader=CommonFileBusinessWal.openExistingReadOnly(original,e)){
+            reader.requireHistoricalSignedPrefix(e,seq,args[3]);
+            java.util.List<CommonFileBusinessWal.CommittedWalFrame> window=
+                reader.readCertifiedWindow(e,seq,args[3],0,4,64L*1024L*1024L);
+            if(window.isEmpty() || window.get(0).sequence!=1)
+                throw new IllegalStateException("verified signed WAL prefix not contiguous");
+            System.out.println("ORIGINAL_WAL_CERTIFIED_PREFIX_READ_ONLY_PASS signed="+seq
+                    +" extraUncertified="+(reader.forcedSequence()-seq)
+                    +" windowFrames="+window.size());
+        }
+    }
+}
