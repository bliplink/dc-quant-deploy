+package com.app.common.replication;
+
+import static org.junit.Assert.*;
+import java.nio.file.*;
+import java.io.IOException;
+import java.security.*;
+import java.util.Arrays;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/** Exact durable E1 signed approval resume: no re-signing and no ZK shortcut. */
+public final class CommonOriginalE1FirstReadyTicketResumeTest {
+    private static KeyPair a,b;
+    @BeforeClass public static void init()throws Exception {
+        KeyPairGenerator gen=KeyPairGenerator.getInstance("RSA");
+        gen.initialize(2048);a=gen.generateKeyPair();b=gen.generateKeyPair();
+    }
+    interface Operation {void run()throws Exception;}
+    static void rejected(Operation op)throws Exception {
+        try {op.run();fail("unsigned/replayed/changed ticket accepted");}
+        catch(IOException expected){}
+    }
+    static byte[] payload() {
+        return ("OTC_COMMON_VIRGIN_E1_DUAL_RSA_TO_FIRST_E2_READY_V1\n"+
+            "OrderSvr\n/otc/demo-ns/order\n0\nmanifest-hash\nready-hash\ngenesis-hash\n")
+            .getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    }
+    @Test public void fsyncedFirstReadyTicketCanResumeWithoutAnyRewrite()throws Exception {
+        Path root=Files.createTempDirectory("t253-durable-ticket");
+        Path path=root.resolve("first-ready/e1-to-e2-A.signed");
+        byte[] payload=payload();
+        CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            path,payload,a.getPrivate(),a.getPublic());
+        byte[] original=Files.readAllBytes(path);
+        CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            path,payload,a.getPrivate(),a.getPublic());
+        assertArrayEquals(original,Files.readAllBytes(path));
+    }
+    @Test public void changedManifestOrGenesisDeniesResume()throws Exception {
+        Path p=Files.createTempDirectory("t253-mutated").resolve("ticket");
+        byte[] exact=payload();
+        CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,exact,a.getPrivate(),a.getPublic());
+        byte[] changed=Arrays.copyOf(exact,exact.length);
+        changed[changed.length-4]^=0x01;
+        rejected(()->CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,changed,a.getPrivate(),a.getPublic()));
+    }
+    @Test public void wrongPinnedNodeCannotResumeSignedTicket()throws Exception {
+        Path p=Files.createTempDirectory("t253-wrong-pub").resolve("ticket");
+        CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,payload(),a.getPrivate(),a.getPublic());
+        rejected(()->CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,payload(),a.getPrivate(),b.getPublic()));
+        rejected(()->CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,payload(),b.getPrivate(),b.getPublic()));
+    }
+    @Test public void truncatedOrTamperedSignatureFailsClosed()throws Exception {
+        Path p=Files.createTempDirectory("t253-bad-sign").resolve("ticket");
+        CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,payload(),a.getPrivate(),a.getPublic());
+        byte[] signed=Files.readAllBytes(p);
+        byte[] corrupt=signed.clone();corrupt[corrupt.length-1]^=0x10;
+        Files.write(p,corrupt,StandardOpenOption.TRUNCATE_EXISTING);
+        rejected(()->CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,payload(),a.getPrivate(),a.getPublic()));
+        Files.write(p,Arrays.copyOf(signed,signed.length-1),StandardOpenOption.TRUNCATE_EXISTING);
+        rejected(()->CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            p,payload(),a.getPrivate(),a.getPublic()));
+    }
+    @Test public void symlinkedExistingTicketFailsClosed()throws Exception {
+        Path d=Files.createTempDirectory("t253-symlink");
+        Path real=d.resolve("real");Path link=d.resolve("link");
+        CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            real,payload(),a.getPrivate(),a.getPublic());
+        Files.createSymbolicLink(link,real);
+        rejected(()->CommonOriginalE1FirstReadyActivation.persistOrVerifyTicket(
+            link,payload(),a.getPrivate(),a.getPublic()));
+    }
+}
