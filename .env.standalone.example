COMPOSE_PROJECT_NAME=dc-quant-deploy
DEPLOY_ROOT=/opt/dc-runtime
RUNTIME_UID=1000
RUNTIME_GID=1000
SERVICE_HOST=127.0.0.1
REQUIRE_GHCR_LOGIN=false
DC_LICENSE_URL=
MIN_SELECTED_MEMORY_MB=1024
MIN_SELECTED_DISK_GB=5
MIN_MEMORY_MB=8192
MIN_DISK_GB=20

CLICKHOUSE_MODE=embedded
CLICKHOUSE_IMAGE_REPOSITORY=docker.m.daocloud.io/clickhouse/clickhouse-server
CLICKHOUSE_IMAGE_TAG=25.9.3.48
CLICKHOUSE_DB_NAME=dc
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_APPLY_OPTIONAL_SEED=true

WEB_LISTEN_PORT=80
WEB_FALLBACK_LISTEN_PORT=8088
GATEWAY_HOST=127.0.0.1
GW_TCP_PORT=3000
GW_WEBSOCKET_PORT=3001
GATEWAY_PORT=3002
LOGINSVR_HTTP_PORT=19990
BATCHSVR_HTTP_PORT=18080
MDSVR_GW_PORT=30028
APSSVR_GW_PORT=30035
LOGINSVR_GW_PORT=20034
QUANTSVR_GW_PORT=30042
INDSVR_GW_PORT=30044
CUSTOMINDSVR_GW_PORT=30047
SIMSVR_GW_PORT=30045
BATCHSVR_GW_PORT=30046

GW_TAG=latest
LOGINSVR_TAG=latest
MDSVR_TAG=latest
APSSVR_TAG=latest
QUANTSVR_TAG=latest
INDSVR_TAG=latest
CUSTOMINDSVR_TAG=latest
SIMSVR_TAG=latest
BATCHSVR_TAG=latest
WEB_TAG=latest
ZOOKEEPER_TAG=v0.0.3-test

PUBLIC_SSH_PORT=22
CLICKHOUSE_PUBLIC_HTTP_PORT=28123
CLICKHOUSE_PUBLIC_ACCESS=true
ALLOW_GW_PUBLIC=true
SECURITY_AUTO_ROLLBACK_MINUTES=5

QUANTSVR_ENABLE_BOT=
QUANTSVR_BOT_TOKEN=
QUANTSVR_BOT_USERNAME=
QUANTSVR_BOT_GROUP_ID=
QUANTSVR_BOT_ADMIN_LIST=
INDSVR_DEEPSEEK_API_KEY=
STRATEGY_SIGNAL_CHANNEL=CD
STRATEGY_VENUE_TYPE_GW=BNFutures
