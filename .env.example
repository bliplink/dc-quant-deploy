COMPOSE_PROJECT_NAME=dc-saas
DEPLOY_ROOT=/data/dc-saas-runtime
BUILD_ROOT=/data/dc-saas-build
RUNTIME_UID=0
RUNTIME_GID=0
IMAGE_SOURCE=registry

MYSQL_IMAGE_REPOSITORY=docker.m.daocloud.io/library/mysql
MYSQL_IMAGE_TAG=8.0.36
MYSQL_PORT=33306
MYSQL_USERNAME=dc
MYSQL_PASSWORD=replace-with-generated-secret
MYSQL_ROOT_PASSWORD=replace-with-generated-secret

CLICKHOUSE_IMAGE_REPOSITORY=docker.m.daocloud.io/clickhouse/clickhouse-server
CLICKHOUSE_IMAGE_TAG=25.9.3.48
CLICKHOUSE_HTTP_PORT=38123
CLICKHOUSE_NATIVE_PORT=39000
CLICKHOUSE_USERNAME=dc
CLICKHOUSE_PASSWORD=replace-with-generated-secret

ZOOKEEPER_IMAGE_REPOSITORY=docker.m.daocloud.io/library/zookeeper
ZOOKEEPER_TAG=3.8.4
ZOOKEEPER_PORT=32181
ZOOKEEPER_JMX_PORT=38888

GW_TCP_PORT=33000
GW_WEBSOCKET_PORT=33001
GW_HTTP_PORT=33002
LOGINSVR_HTTP_PORT=33990
LOGINSVR_GW_PORT=33034
MDSVR_GW_PORT=33028
APSSVR_GW_PORT=33035
ORDERSVR_GW_PORT=33036
TRADESVR_GW_PORT=33037
LIQSVR_GW_PORT=33038
MANAGERSVR_GW_PORT=33039
ADMINSVR_GW_PORT=33040
WEB_LISTEN_PORT=18088

GW_TAG=saas-crypto
GW_IMAGE_REPOSITORY=ghcr.io/bliplink/gw
LOGINSVR_TAG=saas-crypto
LOGINSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/loginsvr
MDSVR_TAG=saas-crypto
MDSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/mdsvr
APSSVR_TAG=saas-crypto
APSSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/apssvr
ORDERSVR_TAG=saas-crypto
ORDERSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/ordersvr
TRADESVR_TAG=saas-crypto
TRADESVR_IMAGE_REPOSITORY=ghcr.io/bliplink/tradesvr
LIQSVR_TAG=saas-crypto
LIQSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/liqsvr
MANAGERSVR_TAG=saas-crypto
MANAGERSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/managersvr
ADMINSVR_TAG=saas-crypto
ADMINSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/adminsvr
ROBOTSVR_TAG=saas-crypto
ROBOTSVR_IMAGE_REPOSITORY=ghcr.io/bliplink/robotsvr
TRADE_WEB_TAG=saas-crypto
TRADE_WEB_IMAGE_REPOSITORY=ghcr.io/bliplink/dc-saas-trade-web

MAVEN_BUILD_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-8

APSSVR_BINANCE_REST_URL=https://fapi.binance.com
APSSVR_BINANCE_WS_URL=wss://fstream.binance.com/ws
APSSVR_SYMBOLS="btcusdt|ethusdt"
APSSVR_SYMBOL_ALIASES="btcusdt|ethusdt"
APSSVR_ENABLE_USER_DATA=false
TRADE_ALLOW_MISSING_MARK_PRICE=false
TRADE_EXECUTION_DEDUPE_MAX_ENTRIES=1000000
ORDER_SELF_TRADE_PREVENTION_MODE=CANCEL_TAKER
LIQUIDATION_PARTIAL_ENABLED=true
LIQUIDATION_PARTIAL_RATIO=0.25
LOGIN_DEFAULT_PASSWORD=replace-with-generated-secret
PLATFORM_ADMIN_USERNAME=platformadmin
PLATFORM_ADMIN_PASSWORD=replace-with-generated-secret
DC_HEDGE_CREDENTIAL_MASTER_KEY=replace-with-generated-secret

# Legacy environment-managed hedge credentials. New tenant console credentials
# are AES-GCM encrypted in MySQL with DC_HEDGE_CREDENTIAL_MASTER_KEY.
# ROBOT_HEDGE_ACCOUNTS_JSON={"tenant-a-main":{"api_key":"...","secret_key":"..."}}
ROBOT_HEDGE_ACCOUNTS_JSON=
ROBOT_CONFIG_POLL_MS=3000
ROBOT_LEASE_SECONDS=15
ROBOT_FAILURE_THRESHOLD=3

REQUIRE_GHCR_LOGIN=false

# JVM/container memory defaults are sized for the complete single-host SaaS
# acceptance stack. Override individual values for production load tests.
MYSQL_MEMORY_LIMIT=1536m
CLICKHOUSE_MEMORY_LIMIT=2048m
ZOOKEEPER_MEMORY_LIMIT=384m
TRADE_WEB_MEMORY_LIMIT=256m
GW_MEMORY_LIMIT=512m
LOGINSVR_MEMORY_LIMIT=384m
MDSVR_MEMORY_LIMIT=640m
APSSVR_MEMORY_LIMIT=640m
ORDERSVR_MEMORY_LIMIT=640m
TRADESVR_MEMORY_LIMIT=896m
LIQSVR_MEMORY_LIMIT=384m
MANAGERSVR_MEMORY_LIMIT=384m
ADMINSVR_MEMORY_LIMIT=384m
ROBOTSVR_MEMORY_LIMIT=384m

# Shared-host CPU ceilings protect the independent quantitative stack. These
# values are conservative acceptance defaults, not exchange-scale capacity.
MYSQL_CPU_LIMIT=0.50
CLICKHOUSE_CPU_LIMIT=0.75
ZOOKEEPER_CPU_LIMIT=0.10
TRADE_WEB_CPU_LIMIT=0.10
GW_CPU_LIMIT=0.35
LOGINSVR_CPU_LIMIT=0.15
MDSVR_CPU_LIMIT=0.35
APSSVR_CPU_LIMIT=0.35
ORDERSVR_CPU_LIMIT=0.50
TRADESVR_CPU_LIMIT=0.50
LIQSVR_CPU_LIMIT=0.15
MANAGERSVR_CPU_LIMIT=0.15
ADMINSVR_CPU_LIMIT=0.15
ROBOTSVR_CPU_LIMIT=0.20

SAAS_MIN_TOTAL_MEMORY_MB=7680
SAAS_MIN_AVAILABLE_MEMORY_MB=2048
SAAS_MIN_RUNTIME_DISK_GB=100
SAAS_MIN_DOCKER_DISK_GB=15

# Public GHCR image auto-deployment. Infrastructure images are never updated.
SAAS_AUTO_UPDATE_INTERVAL_MINUTES=5
SAAS_AUTO_UPDATE_QUIET_SECONDS=300
SAAS_AUTO_UPDATE_PULL_TIMEOUT_SECONDS=600
SAAS_AUTO_UPDATE_MANIFEST_TIMEOUT_SECONDS=30
SAAS_AUTO_UPDATE_GIT_TIMEOUT_SECONDS=180
SAAS_AUTO_UPDATE_GIT_FETCH_ATTEMPTS=3
SAAS_AUTO_UPDATE_FAILURE_BACKOFF_SECONDS=600
SAAS_AUTO_UPDATE_FAILURE_MAX_BACKOFF_SECONDS=21600
SAAS_AUTO_UPDATE_DEPLOY_REPO=true
SAAS_AUTO_UPDATE_DEPLOY_BRANCH=saas-crypto
